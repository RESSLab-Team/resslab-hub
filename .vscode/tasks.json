{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend-dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "base": "$tsc-watch",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "VITE v",
            "endsPattern": "press h to show help"
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "frontend"
      }
    },
    {
      "label": "database-up",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": true,
          "services": [
            "database"
          ]
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ]
      }
    }
  ]
}