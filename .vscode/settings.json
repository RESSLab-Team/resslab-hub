{
    "editor.formatOnSave": true,
    "python.analysis.stubPath": "${workspaceFolder}/backend",
    "python.analysis.typeCheckingMode": "strict",
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv",
    "python.linting.pycodestyleEnabled": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestPath": "${workspaceFolder}/backend/tests",
    "sort-imports.ignore-type-defs": false,
    "sort-imports.languages": [
        "javascript",
        "typescript",
        "vue",
    ],
    "sort-imports.on-save": true,
}