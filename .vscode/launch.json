{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "backend: run",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["resslab_tools.main:app", "--reload"],
      "jinja": true,
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "frontend: run",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "serve",
      "sourceMapPathOverrides": {
        "webpack:/*": "${webRoot}/*",
        "/./*": "${webRoot}/*",
        "/src/*": "${webRoot}/*",
        "/*": "*",
        "/./~/*": "${webRoot}/node_modules/*"
      }
    },
    {
      "name": "backend: data-uploader",
      "type": "python",
      "request": "launch",
      "module": "data.uploader",
      "args": ["column", "../../resslab-hub-data/columns/steel_columns.csv"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend: data-analyzer",
      "type": "python",
      "request": "launch",
      "module": "data.analyzer",
      "args": [
        "../../resslab-hub-data/connections/connections.csv",
        "../../resslab-hub-data/columns/steel_columns.csv",
        "../../resslab-hub-data/braces/steel_braces.csv"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend: data-csv-transformer",
      "type": "python",
      "request": "launch",
      "module": "data.csv_transformer",
      "args": [
        "japanese",
        "../../resslab-hub-data/connections/component/japanese.csv",
        "../frontend/src/assets/connection/japanese-sections.csv"
      ],
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
