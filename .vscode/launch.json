{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "frontend-dev-firefox",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "frontend-dev"
    },
    {
      "name": "backend-dev",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "resslab_hub.main:app",
        "--reload"
      ],
      "jinja": true,
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env",
      "preLaunchTask": "database-up"
    },
    {
      "name": "backend-data-uploader-table",
      "type": "python",
      "request": "launch",
      "module": "data.uploader",
      "args": [
        "material",
        "../../resslab-hub-data/material/steel_material.csv"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend-data-uploader-csv",
      "type": "python",
      "request": "launch",
      "module": "data.uploader",
      "args": [
        "connection-beam",
        "../../resslab-hub-data/connections/Beam_moment_rotation/*.csv"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend-data-uploader-all",
      "type": "python",
      "request": "launch",
      "module": "data.uploader",
      "args": [
        "all",
        "../../resslab-hub-data"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend-data-analyzer",
      "type": "python",
      "request": "launch",
      "module": "data.analyzer",
      "args": [
        "../../resslab-hub-data/connections/connections.csv",
        "../../resslab-hub-data/columns/steel_columns.csv",
        "../../resslab-hub-data/braces/steel_braces.csv",
        "../../resslab-hub-data/material/steel_material.csv"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/secrets/.env"
    },
    {
      "name": "backend-data-csv-transformer",
      "type": "python",
      "request": "launch",
      "module": "data.csv_transformer",
      "args": [
        "japanese",
        "../../resslab-hub-data/connections/component/japanese.csv",
        "../frontend/src/assets/connection/japanese-sections.csv"
      ],
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}