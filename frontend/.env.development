# Same-origin through the Vite dev proxy (see vite.config.ts), like Traefik in
# the deployments. Session cookies only work first-party, so this must not be
# an absolute URL to another host or port.
VITE_APP_BACKEND_URL=/api
# Served by Vite from frontend/public/sem (symlink to resslab-hub-data/material/ductile_fracture/sem/_webp);
# populate it with `DRY_RUN=1 make precompute-sem` from the backend. See CLAUDE.md.
VITE_SEM_CDN_BASE_URL=/sem
