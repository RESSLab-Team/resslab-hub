VITE_APP_BACKEND_URL=http://127.0.0.1:8000
# Served by Vite from frontend/public/sem (symlink to resslab-hub-data/ductile_fracture/sem/_webp);
# populate it with `DRY_RUN=1 make precompute-sem` from the backend. See CLAUDE.md.
VITE_SEM_CDN_BASE_URL=/sem
# HTTP Basic credentials the contribution pipeline uses to reach /validate.
# These are the backend's development defaults (backend/resslab_hub/settings.toml).
# If your secrets/.env sets a different API_PASSWORD, override it in
# frontend/.env.development.local (gitignored) rather than editing this file.
VITE_APP_API_USERNAME=user
VITE_APP_API_PASSWORD=changeit
