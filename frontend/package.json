{
  "name": "resslab-hub",
  "version": "2.5.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench:dashboard": "node scripts/bench-dashboard.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "rm -rf src/backend && openapi-generator-cli generate",
    "kpi:snapshot": "node scripts/update-kpi-snapshot.mjs"
  },
  "dependencies": {
    "@stdlib/stats-base-dists-lognormal-cdf": "^0.2.3",
    "axios": "^1.21.1",
    "colormap": "^2.3.2",
    "d3-array": "^3.2.5",
    "dompurify": "^3.5.0",
    "downloadjs": "^1.4.7",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.0.9",
    "hex-rgb": "^5.0.0",
    "jszip": "^3.10.2",
    "lodash": "^4.17.21",
    "maplibre-gl": "^6.19.0",
    "marked": "^18.2.1",
    "mathjs": "^11.6.0",
    "pinia": "^2.0.33",
    "vue": "^3.5.46",
    "vue-echarts": "^8.3.2",
    "vue-gtag": "^2.0.1",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.1.6",
    "vuetify": "^3.3.15"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@mdi/js": "^7.1.96",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@rollup/plugin-dsv": "^3.0.2",
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/colormap": "^2.3.1",
    "@types/d3-array": "^3.2.2",
    "@types/downloadjs": "^1.4.3",
    "@types/jsdom": "^21.1.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^8.34.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.0.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.65.1",
    "prettier": "^2.8.4",
    "prettier-plugin-organize-imports": "^3.2.2",
    "sass": "^1.108.2",
    "typescript": "~5.9.0",
    "vite": "^6.4.6",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  }
}
