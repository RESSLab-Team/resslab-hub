{
  "name": "resslab-tools",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "vue-cli-service lint",
    "api": "rm -rf src/backend && openapi-generator-cli generate -i ../openapi.json -g typescript-axios -o src/backend",
    "i18n:report": "vue-cli-service i18n:report --src \"./src/**/*.?(js|vue)\" --locales \"./src/locales/**/*.json\""
  },
  "dependencies": {
    "axios": "^0.27.2",
    "core-js": "^3.8.3",
    "d3-array": "^3.1.1",
    "downloadjs": "^1.4.7",
    "echarts": "^5.3.3",
    "jszip": "^3.7.1",
    "lodash": "^4.17.21",
    "register-service-worker": "^1.7.2",
    "v-switch-case": "^1.0.3",
    "vue": "^2.6.14",
    "vue-class-component": "^7.2.3",
    "vue-echarts": "^6.1.0",
    "vue-i18n": "^8.26.3",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.5.1",
    "vuetify": "^2.4.0",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.5.1",
    "@types/chai": "^4.2.15",
    "@types/d3-array": "^3.0.2",
    "@types/downloadjs": "^1.4.2",
    "@types/lodash": "^4.14.177",
    "@types/mocha": "^8.2.1",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vue/cli-plugin-babel": "~5.0.7",
    "@vue/cli-plugin-eslint": "~5.0.7",
    "@vue/cli-plugin-pwa": "~5.0.7",
    "@vue/cli-plugin-router": "~5.0.7",
    "@vue/cli-plugin-typescript": "~5.0.7",
    "@vue/cli-plugin-unit-mocha": "~5.0.7",
    "@vue/cli-plugin-vuex": "~5.0.7",
    "@vue/cli-service": "~5.0.7",
    "@vue/component-compiler-utils": "^3.3.0",
    "@vue/composition-api": "^1.7.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^1.1.3",
    "chai": "^4.1.2",
    "csv-loader": "^3.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.0.3",
    "lint-staged": "^11.1.2",
    "prettier": "^2.4.1",
    "prettier-plugin-organize-imports": "^2.3.4",
    "sass": "~1.32.0",
    "sass-loader": "^12.0.0",
    "typescript": "~4.5.5",
    "vue-cli-plugin-i18n": "~2.3.1",
    "vue-cli-plugin-vuetify": "~2.5.1",
    "vue-template-compiler": "2.6.14",
    "vuetify-loader": "^1.7.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
}